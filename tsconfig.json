{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "types": ["node"]
    },
    "include": ["."],
    "exclude": ["node_modules", "dist"]
}
