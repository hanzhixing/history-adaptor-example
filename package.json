{
    "name": "history-adaptor-example",
    "private": true,
    "description": "Interactive examples for history-adaptor",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:pages": "BASE_PATH=${BASE_PATH:-/history-adaptor-example/} vite build",
        "preview": "vite preview",
        "preview:pages": "BASE_PATH=${BASE_PATH:-/history-adaptor-example/} vite preview",
        "deploy": "pnpm build:pages && gh-pages -d dist",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@angular/common": "22.2.5",
        "@angular/compiler": "22.2.5",
        "@angular/core": "22.2.5",
        "@angular/platform-browser": "22.2.5",
        "@angular/router": "22.2.5",
        "@solidjs/router": "^1.0.1",
        "highlight.js": "^11.12.0",
        "history-adaptor": "^1.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "rxjs": "^7.8.2",
        "solid-js": "^1.9.18",
        "tslib": "^2.9.1",
        "vue": "^3.5.45",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitejs/plugin-vue": "^6.0.10",
        "gh-pages": "^6.3.0",
        "jsdom": "^31.0.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.6",
        "vite-plugin-solid": "^2.11.15",
        "vitest": "^5.1.0"
    }
